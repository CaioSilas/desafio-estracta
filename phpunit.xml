<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache">
    <testsuites>
        <!-- Suíte padrão (composer test): sem acesso à rede. -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Opcional (composer test:integracao): consulta o portal real; exige SEFAZ_BA_CNPJ. -->
        <testsuite name="Integracao">
            <directory>tests/Integracao</directory>
        </testsuite>
    </testsuites>
</phpunit>
